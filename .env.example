# ==============================================================================
# RentTrust UZ — Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO GIT
# ==============================================================================

# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_Example

# Telegram Bot Username & WebApp Short Name
BOT_USERNAME=RentTrust_Uz_Bot
APP_SHORT_NAME=app

# Secret Key for Signing Session Tokens (HMAC-SHA256)
SECRET_KEY=replace_with_a_long_random_hex_string_32_bytes_or_more

# Admin Telegram IDs (comma-separated integers allowed to access admin moderation)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Telegram Webhook Secret Token (sent in X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=replace_with_random_telegram_webhook_secret

# Payment Provider Mode: manual | mock | click_payme
PAYMENT_MODE=manual

# Click & Payme Merchant Credentials (when PAYMENT_MODE=click_payme)
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

# Supabase REST API (Optional / if connected to cloud DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Server Port and Environment
PORT=5000
FLASK_ENV=production
